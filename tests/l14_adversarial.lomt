// l14_adversarial.lomt — a hostile model: unauthorized kill denied and
// audited, authorized isolate executes, NLC policy pollution rejected.
// Port of LinuxFUAI tests/l14_adversarial.c (run with FUJO_EVIL=1).

module l14_adversarial

choose runtime

use "harness.lomt"

fn _start() {
    let s: ptr = st_new();
    fuai_init(s, 0 as u64);
    fuai_payload_register(1);
    fuai_payload_main(s);
    t_reset(s);
    let neg1: i64 = 0 as i64 - 1;

    // LAUNCH | ISOLATE | RESUME (no KILL, no SET_CFG)
    let perm: u64 = 4 + 2 + 16;
    let d1: i64 = dom_create(s, perm, 1, 0);
    t_check(s, d1 >= 1, "domain created", d1 as u64, 1);
    dom_bind(s, d1 as u64);

    let tid: i64 = cap_exec(s, ACT_LAUNCH, 1, 0);
    t_check(s, tid >= 1, "worker launched under narrow domain", tid as u64, 1);

    let out: ptr = alloc(32);
    let goal: ptr = alloc(128);
    let p: u32 = 0;
    p = b_push_lit(goal, 128, p, "isolate task ");
    p = b_push_dec(goal, 128, p, tid as u64, st_dec(s));
    plan_run(s, goal, p, out);
    t_check(s, b_ld64(out, 0) == 1 && b_ld64(out, 8) == 1,
            "evil plan: kill denied, isolate ok", b_ld64(out, 0), 1);
    t_check(s, task_state(s, tid as u64) == TASK_STOPPED,
            "authorized isolate executed", task_state(s, tid as u64), TASK_STOPPED);

    let buf: ptr = alloc(96 * 32);
    let na: i64 = aud_read(s, buf, 96 * 32);
    let saw_deny: u32 = 0;
    let i: i64 = 0;
    while i < na {
        if b_ld64(buf, (i as u32) * 32 + 8) == 2 &&
           b_ld64(buf, (i as u32) * 32 + 24) == 1 {
            saw_deny = 1;
        }
        i = i + 1;
    }
    t_check(s, saw_deny == 1, "deny audited", saw_deny as u64, 1);

    nlc_set(s, str_ptr("ban games 9 to 18"), 17, out);
    t_check(s, b_ld64(out, 0) == 0, "evil nlc fully rejected", b_ld64(out, 0), 0);
    t_check(s, cfg_get(s, 7) > cfg_get(s, 8), "tau invariant intact", 1, 1);
    t_check(s, cfg_get(s, 1) == 50, "anom threshold intact", 50, 50);

    cap_exec(s, ACT_RESUME, tid as u64, 0);
    dom_revoke(s, d1 as u64);
    dom_bind(s, d1 as u64);
    let rc: i64 = cap_exec(s, ACT_ISOLATE, tid as u64, 0);
    t_check(s, rc == neg1, "revoked domain: all denied", rc as u64, neg1 as u64);

    dom_bind(s, 0);
    cap_exec(s, ACT_KILL, tid as u64, 0);

    fuai_shutdown(s);
    t_done(s, 14, "l14");
}
