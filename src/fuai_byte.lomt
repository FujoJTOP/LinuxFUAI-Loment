// fuai_byte.lomt — byte, string and small number helpers for the FUAI port.
//
// The language has only load8/store8; everything wider is composed here, so
// every module above can stay width-honest (u32 offsets, u64 values).

module fuai_byte

choose runtime

pub fn b_ld16(p: ptr, off: u32) -> u32 {
    let v: u32 = load8(p, off);
    v = v + load8(p, off + 1) * 256;
    return v;
}

pub fn b_st16(p: ptr, off: u32, v: u32) {
    store8(p, off, (v % 256) as u8);
    store8(p, off + 1, (v / 256) as u8);
}

pub fn b_ld32(p: ptr, off: u32) -> u32 {
    let v: u32 = b_ld16(p, off);
    v = v + b_ld16(p, off + 2) * 65536;
    return v;
}

pub fn b_st32(p: ptr, off: u32, v: u32) {
    b_st16(p, off, v % 65536);
    b_st16(p, off + 2, v / 65536);
}

pub fn b_ld64(p: ptr, off: u32) -> u64 {
    let lo: u64 = b_ld32(p, off) as u64;
    let hi: u64 = b_ld32(p, off + 4) as u64;
    return lo + hi * 4294967296;
}

pub fn b_st64(p: ptr, off: u32, v: u64) {
    b_st32(p, off, (v % 4294967296) as u32);
    b_st32(p, off + 4, (v / 4294967296) as u32);
}

pub fn b_zero(p: ptr, n: u32) {
    let i: u32 = 0;
    while i < n {
        store8(p, i, 0 as u8);
        i = i + 1;
    }
}

pub fn b_copy(dst: ptr, src: ptr, n: u32) {
    let i: u32 = 0;
    while i < n {
        store8(dst, i, load8(src, i) as u8);
        i = i + 1;
    }
}

pub fn b_move(dst: ptr, src: ptr, n: u32) {
    let i: u32 = n;
    while i > 0 {
        i = i - 1;
        store8(dst, i, load8(src, i) as u8);
    }
}

pub fn b_eq(a: ptr, b: ptr, n: u32) -> bool {
    let i: u32 = 0;
    while i < n {
        if load8(a, i) != load8(b, i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// NUL-terminated length; the caller owns the terminator.
pub fn b_strlen(p: ptr) -> u32 {
    let i: u32 = 0;
    let going: u32 = 1;
    while going == 1 {
        if load8(p, i) == 0 {
            going = 0;
        } else {
            i = i + 1;
        }
    }
    return i;
}

pub fn b_strcpy(dst: ptr, src: ptr) -> u32 {
    let n: u32 = b_strlen(src);
    b_copy(dst, src, n);
    store8(dst, n, 0 as u8);
    return n;
}

pub fn b_streq(a: ptr, b: ptr) -> bool {
    let an: u32 = b_strlen(a);
    let bn: u32 = b_strlen(b);
    if an != bn {
        return false;
    }
    return b_eq(a, b, an);
}

// Position of needle in hay, or -1.
pub fn b_find_sub(hay: ptr, hn: u32, needle: ptr, nn: u32) -> i64 {
    if nn == 0 || nn > hn {
        return 0 as i64 - 1;
    }
    let i: u32 = 0;
    while i + nn <= hn {
        if b_eq(ptr_add(hay, i), needle, nn) {
            return i as i64;
        }
        i = i + 1;
    }
    return 0 as i64 - 1;
}

pub fn b_find_byte(hay: ptr, hn: u32, ch: u32) -> i64 {
    let i: u32 = 0;
    while i < hn {
        if load8(hay, i) == ch {
            return i as i64;
        }
        i = i + 1;
    }
    return 0 as i64 - 1;
}

// Literal helpers: the only string constants in the language are literals,
// so a wrapper keeps call sites readable.
pub fn b_has_lit(hay: ptr, hn: u32, lit: str) -> bool {
    let n: u32 = str_len(lit);
    if b_find_sub(hay, hn, str_ptr(lit), n) >= 0 {
        return true;
    }
    return false;
}

pub fn b_eq_lit(p: ptr, n: u32, lit: str) -> bool {
    if n != str_len(lit) {
        return false;
    }
    return b_eq(p, str_ptr(lit), n);
}

pub fn b_push_lit(buf: ptr, cap: u32, pos: u32, lit: str) -> u32 {
    let n: u32 = str_len(lit);
    let i: u32 = 0;
    let p: u32 = pos;
    while i < n && p + 1 < cap {
        store8(buf, p, str_byte(lit, i) as u8);
        p = p + 1;
        i = i + 1;
    }
    return p;
}

pub fn b_push_bytes(buf: ptr, cap: u32, pos: u32, src: ptr, n: u32) -> u32 {
    let i: u32 = 0;
    let p: u32 = pos;
    while i < n && p + 1 < cap {
        store8(buf, p, load8(src, i) as u8);
        p = p + 1;
        i = i + 1;
    }
    return p;
}

// Decimal digits of v into buf (NUL-terminated, returned length without NUL).
// The digits are written backwards into the tail of buf, then moved to the
// front; cap must be >= 48 so the two ranges never overlap.
pub fn b_dec_into(buf: ptr, cap: u32, v: u64) -> u32 {
    let base: u32 = cap - 25;
    let i: u32 = 24;
    let x: u64 = v;
    if x == 0 {
        i = 23;
        store8(buf, base + i, 48 as u8);
    }
    while x > 0 {
        i = i - 1;
        store8(buf, base + i, (48 + (x % 10)) as u8);
        x = x / 10;
    }
    let n: u32 = 24 - i;
    let k: u32 = 0;
    while k < n {
        store8(buf, k, load8(buf, base + i + k) as u8);
        k = k + 1;
    }
    store8(buf, n, 0 as u8);
    return n;
}

// Append decimal digits, returning the new position. `scratch` is a caller
// buffer of at least 48 bytes (kept in the single state block: no alloc here).
pub fn b_push_dec(buf: ptr, cap: u32, pos: u32, v: u64, scratch: ptr) -> u32 {
    let n: u32 = b_dec_into(scratch, 64, v);
    return b_push_bytes(buf, cap, pos, scratch, n);
}

pub fn b_lower_copy(src: ptr, n: u32, dst: ptr, cap: u32) -> u32 {
    let m: u32 = n;
    if m > cap {
        m = cap;
    }
    let i: u32 = 0;
    while i < m {
        let c: u32 = load8(src, i);
        if c >= 65 && c <= 90 {
            store8(dst, i, (c + 32) as u8);
        } else {
            store8(dst, i, c as u8);
        }
        i = i + 1;
    }
    return m;
}

pub fn b_first_num(t: ptr, len: u32) -> u64 {
    let v: u64 = 0;
    let saw: u32 = 0;
    let i: u32 = 0;
    while i < len {
        let c: u32 = load8(t, i);
        if c >= 48 && c <= 57 {
            v = v * 10 + (c - 48) as u64;
            saw = 1;
        } else {
            if saw == 1 {
                return v;
            }
        }
        i = i + 1;
    }
    return v;
}

// Find "<key>=<digits>" and store the digits at out (u64). Returns 1 on hit.
pub fn b_parse_num_field(line: ptr, len: u32, key: str, out: ptr) -> u32 {
    let kn: u32 = str_len(key);
    let kp: ptr = str_ptr(key);
    let i: u32 = 0;
    while i + kn <= len {
        if b_eq(ptr_add(line, i), kp, kn) {
            let j: u32 = i + kn;
            let v: u64 = 0;
            let saw: u32 = 0;
            let p: u32 = j;
            while p < len {
                let c: u32 = load8(line, p);
                if c >= 48 && c <= 57 {
                    v = v * 10 + (c - 48) as u64;
                    saw = 1;
                    p = p + 1;
                } else {
                    p = len;
                }
            }
            if saw == 1 {
                b_st64(out, 0, v);
                return 1;
            }
            return 0;
        }
        i = i + 1;
    }
    return 0;
}

// Copy the value of "<key>=" up to " TAG" or end-of-line into out.
pub fn b_parse_seg_field(line: ptr, len: u32, key: str, out: ptr, cap: u32) -> u32 {
    let kn: u32 = str_len(key);
    let kp: ptr = str_ptr(key);
    let i: u32 = 0;
    while i + kn <= len {
        if b_eq(ptr_add(line, i), kp, kn) {
            let j: u32 = i + kn;
            let p: u32 = 0;
            let going: u32 = 1;
            while going == 1 && j < len {
                if j + 4 <= len && load8(line, j) == 32 && load8(line, j + 1) == 84 &&
                   load8(line, j + 2) == 65 && load8(line, j + 3) == 71 {
                    going = 0;
                } else {
                    if p + 1 < cap {
                        store8(out, p, load8(line, j) as u8);
                        p = p + 1;
                    }
                    j = j + 1;
                }
            }
            store8(out, p, 0 as u8);
            return p;
        }
        i = i + 1;
    }
    return 0;
}