// fuai_sys.lomt — Linux x86-64 raw syscall layer for the FUAI port.
//
// The reference implementation (LinuxFUAI, C11) calls libc. Loment builds a
// freestanding ELF with no libc, so every call here is the Linux syscall it
// would have become. Numbers and struct layouts are the x86-64 ABI.

module fuai_sys

choose runtime

use "fuai_byte.lomt"

pub const SYS_FDCWD: u64 = 18446744073709551516;

pub const SYS_O_RDONLY: u64 = 0;
pub const SYS_O_WRONLY: u64 = 1;
pub const SYS_O_RDWR: u64 = 2;
pub const SYS_O_CREAT: u64 = 64;
pub const SYS_O_TRUNC: u64 = 512;
pub const SYS_O_NONBLOCK: u64 = 2048;

pub const SYS_MODE_DIR: u64 = 511;
pub const SYS_MODE_FIFO: u64 = 4534;
pub const SYS_MODE_FILE: u64 = 438;

pub const SYS_SIGKILL: u64 = 9;
pub const SYS_SIGCONT: u64 = 18;
pub const SYS_SIGSTOP: u64 = 19;

pub const SYS_WNOHANG: u64 = 1;
pub const SYS_WUNTRACED: u64 = 2;
pub const SYS_WCONTINUED: u64 = 8;

pub const SYS_CLOCK_MONOTONIC: u64 = 1;
pub const SYS_POLLIN: u32 = 1;

pub const SYS_STDIN: i64 = 0;
pub const SYS_STDOUT: i64 = 1;
pub const SYS_STDERR: i64 = 2;

pub fn sy3(nr: u64, a0: u64, a1: u64, a2: u64) -> i64 {
    return syscall4(nr, a0, a1, a2);
}

pub fn sy6(nr: u64, a0: u64, a1: u64, a2: u64, a3: u64, a4: u64) -> i64 {
    return syscall6(nr, a0, a1, a2, a3, a4);
}

pub fn sy_open(path: ptr, flags: u64, mode: u64) -> i64 {
    return sy6(257, SYS_FDCWD, path as u64, flags, mode, 0);
}

pub fn sy_read(fd: i64, buf: ptr, n: u64) -> i64 {
    return sy3(0, fd as u64, buf as u64, n);
}

pub fn sy_write(fd: i64, buf: ptr, n: u64) -> i64 {
    return sy3(1, fd as u64, buf as u64, n);
}

pub fn sy_pread(fd: i64, buf: ptr, n: u64, off: u64) -> i64 {
    return sy6(17, fd as u64, buf as u64, n, off, 0);
}

pub fn sy_pwrite(fd: i64, buf: ptr, n: u64, off: u64) -> i64 {
    return sy6(18, fd as u64, buf as u64, n, off, 0);
}

pub fn sy_close(fd: i64) -> i64 {
    return sy3(3, fd as u64, 0, 0);
}

pub fn sy_ftruncate(fd: i64, n: u64) -> i64 {
    return sy3(77, fd as u64, n, 0);
}

pub fn sy_mkdir(path: ptr, mode: u64) -> i64 {
    return sy3(258, SYS_FDCWD, path as u64, mode);
}

pub fn sy_mkfifo(path: ptr, mode: u64) -> i64 {
    return sy6(259, SYS_FDCWD, path as u64, mode, 0, 0);
}

pub fn sy_unlink(path: ptr) -> i64 {
    return sy6(263, SYS_FDCWD, path as u64, 0, 0, 0);
}

pub fn sy_rmdir(path: ptr) -> i64 {
    return sy6(263, SYS_FDCWD, path as u64, 512, 0, 0);
}

pub fn sy_readlink(path: ptr, buf: ptr, cap: u64) -> i64 {
    return sy3(89, path as u64, buf as u64, cap);
}

pub fn sy_getpid() -> i64 {
    return sy3(39, 0, 0, 0);
}

pub fn sy_fork() -> i64 {
    return sy3(57, 0, 0, 0);
}

pub fn sy_execve(path: ptr, argv: ptr, envp: ptr) -> i64 {
    return sy3(59, path as u64, argv as u64, envp as u64);
}

pub fn sy_exit(code: u64) {
    sy3(231, code, 0, 0);
    sy3(60, code, 0, 0);
}

pub fn sy_wait4(pid: i64, status: ptr, options: u64) -> i64 {
    return sy6(61, pid as u64, status as u64, options, 0, 0);
}

pub fn sy_kill(pid: i64, sig: u64) -> i64 {
    return sy3(62, pid as u64, sig, 0);
}

pub fn sy_uname(buf: ptr) -> i64 {
    return sy3(63, buf as u64, 0, 0);
}

pub fn sy_getdents(fd: i64, buf: ptr, n: u64) -> i64 {
    return sy3(217, fd as u64, buf as u64, n);
}

pub fn sy_affinity(mask: ptr, n: u64) -> i64 {
    return sy3(204, 0, n, mask as u64);
}

// CLOCK_MONOTONIC into ts (two u64), returns nanoseconds.
pub fn sy_clock_ns(ts: ptr) -> u64 {
    sy3(228, SYS_CLOCK_MONOTONIC, ts as u64, 0);
    let sec: u64 = b_ld64(ts, 0);
    let nsec: u64 = b_ld64(ts, 8);
    return sec * 1000000000 + nsec;
}

pub fn sy_sleep(ts: ptr, sec: u64, nsec: u64) {
    b_st64(ts, 0, sec);
    b_st64(ts, 8, nsec);
    sy3(35, ts as u64, 0, 0);
}

pub fn sy_sleep_ms(ts: ptr, ms: u64) {
    sy_sleep(ts, 0, ms * 1000000);
}

// pollfd is {i32 fd; i16 events; i16 revents} = 8 bytes.
pub fn sy_pollfd_set(pfd: ptr, fd: i64, events: u32) {
    b_st32(pfd, 0, fd as u32);
    b_st16(pfd, 4, events);
    b_st16(pfd, 6, 0);
}

pub fn sy_poll_revents(pfd: ptr) -> u32 {
    return b_ld16(pfd, 6);
}

pub fn sy_poll(pfd: ptr, nfds: u64, timeout_ms: i64) -> i64 {
    return sy3(7, pfd as u64, nfds, timeout_ms as u64);
}

pub fn sy_write_all(fd: i64, buf: ptr, n: u32) -> i64 {
    let off: u32 = 0;
    let rc: i64 = 0;
    while off < n {
        let w: i64 = sy_write(fd, ptr_add(buf, off), (n - off) as u64);
        if w <= 0 {
            return rc;
        }
        rc = rc + w;
        off = off + (w as u32);
    }
    return rc;
}

pub fn sy_puts(fd: i64, s: str) -> i64 {
    return sy_write(fd, str_ptr(s), str_len(s) as u64);
}

pub fn sy_putn(fd: i64, buf: ptr, n: u32) -> i64 {
    return sy_write_all(fd, buf, n);
}

// Read a whole file into buf (NUL-terminated), returns byte count or -1.
pub fn sy_read_file(path: ptr, buf: ptr, cap: u32) -> i64 {
    let fd: i64 = sy_open(path, SYS_O_RDONLY, 0);
    if fd < 0 {
        return 0 as i64 - 1;
    }
    let total: u32 = 0;
    let going: u32 = 1;
    while going == 1 {
        if total + 1 >= cap {
            going = 0;
        } else {
            let r: i64 = sy_read(fd, ptr_add(buf, total), (cap - 1 - total) as u64);
            if r <= 0 {
                going = 0;
            } else {
                total = total + (r as u32);
            }
        }
    }
    store8(buf, total, 0 as u8);
    sy_close(fd);
    return total as i64;
}

pub fn sy_env(buf: ptr, cap: u32) -> i64 {
    return sy_read_file(str_ptr("/proc/self/environ"), buf, cap);
}

pub fn sy_cmdline(buf: ptr, cap: u32) -> i64 {
    return sy_read_file(str_ptr("/proc/self/cmdline"), buf, cap);
}

pub fn sy_self_path(buf: ptr, cap: u32) -> i64 {
    let n: i64 = sy_readlink(str_ptr("/proc/self/exe"), buf, (cap - 1) as u64);
    if n <= 0 {
        return 0 as i64 - 1;
    }
    store8(buf, n as u32, 0 as u8);
    return n;
}